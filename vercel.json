    },
    {
      "source": "/shared-readings/:path*",
      "destination": "/api/proxy?__to=backend&__p=shared-readings/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/proxy?__to=backend&__p=images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

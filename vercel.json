        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/times/:path*",
      "destination": "/api/proxy?__to=backend&__p=times/:path*"
    },
    {
      "source": "/main/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/html(.*)"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/main/:path*",
      "destination": "/api/proxy?__to=backend&__p=main/:path*"
    },
    {
      "source": "/shared-readings/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/html(.*)"
        }
      ],
